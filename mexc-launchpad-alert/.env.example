LINE_CHANNEL_ACCESS_TOKEN=ใส่_CHANNEL_ACCESS_TOKEN_ของ_LINE_MESSAGING_API

# Optional: ถ้าระบุ LINE_TO_ID จะส่งแบบ push ไป user/group/room นี้
# ถ้าไม่ระบุ จะส่ง broadcast ไปผู้ติดตาม bot ทั้งหมด
LINE_TO_ID=

# Optional legacy LINE Notify token ถ้ายังมีระบบเก่าใช้งานอยู่
LINE_NOTIFY_TOKEN=

# MEXC
MEXC_CHECK_INTERVAL_MINUTES=10
MEXC_CHROME_FALLBACK=1
MEXC_INCLUDE_FINISHED=0
MEXC_NOTIFY_ON_FIRST_RUN=0

# คั่นหลาย URL ด้วย comma ใช้เป็นแหล่งประกาศเสริมเกี่ยวกับ launchpad
MEXC_ANNOUNCEMENT_URLS=https://www.mexc.com/support/search?query=launchpad,https://www.mexc.com/support/categories/360000254192-Announcements

# Optional: ระบุ path Chrome เองถ้าเครื่องหาไม่เจอ
CHROME_PATH=
